# OpenTelemetry Configuration
OTEL_SERVICE_NAME=aiops-log-monitor
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4319
OTEL_RESOURCE_ATTRIBUTES=service.name=aiops-log-monitor,service.version=0.1.0,deployment.environment=production
